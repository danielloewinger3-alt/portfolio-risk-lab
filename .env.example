# Copy to .env and fill in. Never commit .env.

# Required only for live LLM features (memo, Q&A answers). Everything works without it.
ANTHROPIC_API_KEY=
RISKLAB_LLM_MODEL=claude-sonnet-5-5
RISKLAB_LLM_CALL_LIMIT=20

# Required by SEC EDGAR for filings ingestion. Format: "Your Name your@email.com"
SEC_USER_AGENT=

# Optional
RISKLAB_DATA_DIR=./data
RISKLAB_OFFLINE=0
