# Copy to .env and fill in. Never commit .env.

# Required only for live LLM features (memo, Q&A answers). Everything works without it.
ANTHROPIC_API_KEY=
RISKLAB_LLM_MODEL=claude-sonnet-5-5
RISKLAB_LLM_CALL_LIMIT=20

# LLM provider: auto | anthropic | openai | ollama | none. "auto" (or unset) picks anthropic
# when ANTHROPIC_API_KEY is set, else openai when RISKLAB_OPENAI_API_KEY is set, else ollama
# when the server below answers, else none (deterministic template memo and retrieval-only Q&A).
RISKLAB_LLM_PROVIDER=auto
RISKLAB_LLM_TIMEOUT=120
# Local model served by Ollama (https://ollama.com): `ollama pull qwen2.5:3b`
RISKLAB_OLLAMA_MODEL=qwen2.5:3b
RISKLAB_OLLAMA_URL=http://127.0.0.1:11434
# Hosted OpenAI-compatible API (the free option for the deployed demo). Defaults are Groq's
# free tier: create a key at https://console.groq.com/keys. For OpenRouter, set the base URL
# to https://openrouter.ai/api/v1 and pick one of its models.
RISKLAB_OPENAI_API_KEY=
RISKLAB_OPENAI_BASE_URL=https://api.groq.com/openai/v1
RISKLAB_OPENAI_MODEL=llama-3.3-70b-versatile

# Required by SEC EDGAR for filings ingestion. Format: "Your Name your@email.com"
SEC_USER_AGENT=

# Optional
RISKLAB_DATA_DIR=./data
RISKLAB_OFFLINE=0
